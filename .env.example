# 이 파일을 .env 로 복사한 뒤 값을 채우세요.

# 대시보드 로그인 비밀번호 (반드시 변경). 실거래 전환 시에도 다시 묻습니다.
ADMIN_PASSWORD=change-me

# 세션 서명 및 API 키 암호화용 비밀값. 비워두면 data/.secret 에 자동 생성됩니다.
SECRET_KEY=

# 업비트 Open API 키 (설정 페이지에서 입력해도 됩니다. 여기 값이 우선)
# 키 발급 시: 허용 IP 등록, '출금하기' 권한은 절대 부여하지 마세요.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# paper: 모의투자만 가능 / live: 대시보드에서 비밀번호 재확인 후 실거래 전환 가능
TRADING_MODE=paper

# 모의투자 시작 원화
PAPER_INITIAL_KRW=10000000

# 리스크 한도
RISK_MAX_ORDER_KRW=1000000
RISK_MAX_POSITION_RATIO=0.3
RISK_DAILY_LOSS_LIMIT_PCT=5

# 실시간 시세 구독 기본 종목
WATCH_MARKETS=KRW-BTC,KRW-ETH,KRW-XRP,KRW-SOL

# 텔레그램 알림 (선택). 대시보드 설정 화면에서 등록하는 것을 권장합니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 뉴스
CRYPTOPANIC_TOKEN=
NEWS_INTERVAL_SEC=300
# DAXA/쟁글 공시 페이지 직접 스크래핑 URL (선택, 쉼표 구분). 비우면 Google News 검색으로 대체합니다.
DISCLOSURE_SCRAPE_URLS=

HOST=127.0.0.1
PORT=8000
